{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "WorkflowSpec",
    "type": "object",
    "properties": {
        "bootstrap": {
            "$ref": "#/$defs/BootstrapConfig"
        },
        "cleanup": {
            "anyOf": [
                {
                    "$ref": "#/$defs/CleanupConfig"
                },
                {
                    "type": "null"
                }
            ],
            "default": null
        },
        "defaults": {
            "anyOf": [
                {
                    "$ref": "#/$defs/DefaultsConfig"
                },
                {
                    "type": "null"
                }
            ],
            "default": null
        },
        "execution": {
            "$ref": "#/$defs/ExecutionConfig",
            "default": {
                "maxConcurrentJobs": null,
                "maxLiveAgents": null,
                "maxLiveServices": null,
                "onFailure": "stop-dependents",
                "retries": 0
            }
        },
        "files": {
            "anyOf": [
                {
                    "$ref": "#/$defs/FilesConfig"
                },
                {
                    "type": "null"
                }
            ],
            "default": null
        },
        "inputs": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/InputDef"
            },
            "default": {}
        },
        "name": {
            "type": "string"
        },
        "profiles": {
            "description": "ブランチ名で選ぶ構成(docs/integrations/external-tools.md#profiles)。最初に一致したものを使う。",
            "type": "array",
            "items": {
                "$ref": "#/$defs/ProfileDef"
            }
        },
        "tasks": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/TaskDef"
            }
        },
        "version": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
        },
        "workspace": {
            "$ref": "#/$defs/WorkspaceConfig"
        },
        "worktree": {
            "$ref": "#/$defs/WorktreeConfig"
        }
    },
    "additionalProperties": false,
    "required": [
        "version",
        "name",
        "worktree",
        "bootstrap",
        "tasks",
        "workspace"
    ],
    "$defs": {
        "AgentKind": {
            "type": "string",
            "enum": ["claude"]
        },
        "AgentSpec": {
            "type": "object",
            "properties": {
                "kind": {
                    "$ref": "#/$defs/AgentKind"
                }
            },
            "additionalProperties": false,
            "required": ["kind"]
        },
        "BootstrapConfig": {
            "type": "object",
            "properties": {
                "targets": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false,
            "required": ["targets"]
        },
        "CheckedOutPolicy": {
            "type": "string",
            "enum": ["error"]
        },
        "CleanupConfig": {
            "type": "object",
            "properties": {
                "onStop": {
                    "$ref": "#/$defs/OnStopConfig"
                }
            },
            "additionalProperties": false,
            "required": ["onStop"]
        },
        "DefaultsConfig": {
            "type": "object",
            "properties": {
                "cwd": {
                    "type": ["string", "null"],
                    "default": null
                },
                "env": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/EnvValue"
                    },
                    "default": {}
                },
                "jobTimeoutSeconds": {
                    "type": ["integer", "null"],
                    "format": "uint64",
                    "default": null,
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "DependencyCondition": {
            "type": "string",
            "enum": ["succeeded", "ready", "started"]
        },
        "DependsOn": {
            "type": "object",
            "properties": {
                "condition": {
                    "$ref": "#/$defs/DependencyCondition"
                },
                "task": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "required": ["task", "condition"]
        },
        "EnvValue": {
            "description": "環境変数の値。文字列、秘密値参照、または`null`(継承した値の削除)。",
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "$ref": "#/$defs/SecretRef"
                },
                {
                    "type": "null"
                }
            ]
        },
        "ExecutionConfig": {
            "type": "object",
            "properties": {
                "maxConcurrentJobs": {
                    "type": ["integer", "null"],
                    "format": "uint32",
                    "default": null,
                    "minimum": 0
                },
                "maxLiveAgents": {
                    "type": ["integer", "null"],
                    "format": "uint32",
                    "default": null,
                    "minimum": 0
                },
                "maxLiveServices": {
                    "type": ["integer", "null"],
                    "format": "uint32",
                    "default": null,
                    "minimum": 0
                },
                "onFailure": {
                    "$ref": "#/$defs/OnFailurePolicy",
                    "default": "stop-dependents"
                },
                "retries": {
                    "type": "integer",
                    "format": "uint32",
                    "default": 0,
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "ExistingBranchPolicy": {
            "type": "string",
            "enum": ["use"]
        },
        "FileCopyRule": {
            "type": "object",
            "properties": {
                "from": {
                    "type": "string"
                },
                "ifExists": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/IfExistsPolicy"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "optional": {
                    "type": "boolean",
                    "default": false
                },
                "to": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "required": ["from", "to"]
        },
        "FilesConfig": {
            "type": "object",
            "properties": {
                "copy": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "$ref": "#/$defs/FileCopyRule"
                    }
                },
                "requireIgnored": {
                    "type": "boolean",
                    "default": false
                },
                "source": {
                    "$ref": "#/$defs/FilesSource"
                },
                "symlinks": {
                    "$ref": "#/$defs/SymlinkPolicy",
                    "default": "reject"
                }
            },
            "additionalProperties": false,
            "required": ["source"]
        },
        "FilesSource": {
            "type": "string",
            "enum": ["primary"]
        },
        "HerdrActionSpec": {
            "description": "Herdrプラグインのactionの呼び出し(Q08、docs/integrations/external-tools.md#herdr-action)。",
            "type": "object",
            "properties": {
                "action": {
                    "description": "`plugin.action.invoke`の`action_id`。",
                    "type": "string"
                },
                "plugin": {
                    "description": "実行記録を照会するプラグインID。省略時は呼び出しの応答から得る。",
                    "type": ["string", "null"]
                },
                "pollIntervalMilliseconds": {
                    "description": "実行記録の照会間隔(100〜60000ミリ秒)。",
                    "type": "integer",
                    "format": "uint64",
                    "default": 1000,
                    "minimum": 0
                }
            },
            "additionalProperties": false,
            "required": ["action"]
        },
        "IfExistsPolicy": {
            "type": "string",
            "enum": ["error", "skip", "replace"]
        },
        "InitialTabPolicy": {
            "type": "string",
            "enum": ["preserve"]
        },
        "InputDef": {
            "type": "object",
            "properties": {
                "default": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/InputDefault"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "required": {
                    "type": "boolean",
                    "default": false
                },
                "type": {
                    "$ref": "#/$defs/InputType"
                }
            },
            "additionalProperties": false,
            "required": ["type"]
        },
        "InputDefault": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "integer",
                    "format": "int64"
                },
                {
                    "type": "boolean"
                }
            ]
        },
        "InputType": {
            "type": "string",
            "enum": ["string", "integer", "boolean"]
        },
        "LayoutConfig": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "columns": {
                            "type": "integer",
                            "format": "uint32",
                            "minimum": 0
                        },
                        "rows": {
                            "type": "integer",
                            "format": "uint32",
                            "minimum": 0
                        },
                        "type": {
                            "type": "string",
                            "const": "grid"
                        }
                    },
                    "additionalProperties": false,
                    "required": ["type", "columns", "rows"]
                }
            ]
        },
        "LogStream": {
            "type": "string",
            "enum": ["stdout", "stderr", "any"]
        },
        "MonitorConfig": {
            "description": "ready後の継続確認。両方のキーが必須。",
            "type": "object",
            "properties": {
                "failureThreshold": {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                },
                "intervalSeconds": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                }
            },
            "additionalProperties": false,
            "required": ["intervalSeconds", "failureThreshold"]
        },
        "OnDependencyLost": {
            "type": "string",
            "enum": ["stop"]
        },
        "OnFailurePolicy": {
            "type": "string",
            "enum": ["stop-dependents"]
        },
        "OnStopConfig": {
            "type": "object",
            "properties": {
                "branch": {
                    "$ref": "#/$defs/PreserveOnlyPolicy"
                },
                "panes": {
                    "$ref": "#/$defs/PreserveOnlyPolicy"
                },
                "processes": {
                    "$ref": "#/$defs/ProcessesCleanupPolicy"
                },
                "worktree": {
                    "$ref": "#/$defs/PreserveOnlyPolicy"
                }
            },
            "additionalProperties": false,
            "required": ["processes", "panes", "worktree", "branch"]
        },
        "PaneConfig": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                },
                "placement": {
                    "$ref": "#/$defs/Placement"
                },
                "view": {
                    "$ref": "#/$defs/PaneView"
                }
            },
            "additionalProperties": false,
            "required": ["id", "label", "view", "placement"]
        },
        "PaneView": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "task": {
                            "type": "string"
                        },
                        "type": {
                            "type": "string",
                            "const": "logs"
                        }
                    },
                    "additionalProperties": false,
                    "required": ["type", "task"]
                },
                {
                    "type": "object",
                    "properties": {
                        "task": {
                            "type": "string"
                        },
                        "type": {
                            "type": "string",
                            "const": "agent"
                        }
                    },
                    "additionalProperties": false,
                    "required": ["type", "task"]
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "status"
                        }
                    },
                    "additionalProperties": false,
                    "required": ["type"]
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "shell"
                        }
                    },
                    "additionalProperties": false,
                    "required": ["type"]
                }
            ]
        },
        "Placement": {
            "type": "object",
            "properties": {
                "colSpan": {
                    "type": "integer",
                    "format": "uint32",
                    "default": 1,
                    "minimum": 0
                },
                "column": {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                },
                "row": {
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                },
                "rowSpan": {
                    "type": "integer",
                    "format": "uint32",
                    "default": 1,
                    "minimum": 0
                }
            },
            "additionalProperties": false,
            "required": ["column", "row"]
        },
        "PortValue": {
            "description": "TCPのポート番号。整数、または`${inputs.port}`等の値置換を含む文字列。",
            "anyOf": [
                {
                    "type": "integer",
                    "format": "int64"
                },
                {
                    "type": "string"
                }
            ]
        },
        "PreserveOnlyPolicy": {
            "type": "string",
            "enum": ["preserve"]
        },
        "ProcessesCleanupPolicy": {
            "type": "string",
            "enum": ["stop-owned"]
        },
        "ProfileDef": {
            "description": "ブランチ名に一致したときに適用する構成の差分。",
            "type": "object",
            "properties": {
                "bootstrapTargets": {
                    "description": "`bootstrap.targets`を置き換える。",
                    "type": ["array", "null"],
                    "default": null,
                    "items": {
                        "type": "string"
                    }
                },
                "branch": {
                    "description": "ブランチ名のパターン。`*`は`/`以外の任意の文字列、`**`は`/`を含む任意の文字列、\n`?`は`/`以外の1文字に一致する。",
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "inputs": {
                    "description": "入力の既定値を置き換える。CLIで明示した入力が優先する。",
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/InputDefault"
                    },
                    "default": {}
                }
            },
            "additionalProperties": false,
            "required": ["id", "branch"]
        },
        "RetryConfig": {
            "type": "object",
            "properties": {
                "delaySeconds": {
                    "type": "integer",
                    "format": "uint64",
                    "default": 0,
                    "minimum": 0
                },
                "maxAttempts": {
                    "description": "初回を含む総Attempt数。",
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                }
            },
            "additionalProperties": false,
            "required": ["maxAttempts"]
        },
        "RunnerKind": {
            "oneOf": [
                {
                    "description": "標準出力と標準エラーをパイプで受ける非対話の実行。",
                    "type": "string",
                    "const": "supervised"
                },
                {
                    "description": "擬似端末で実行し、`herdr-workflow term`から操作する対話の実行(ADR-0008)。",
                    "type": "string",
                    "const": "pty"
                }
            ]
        },
        "ScriptSpec": {
            "description": "シェル経由で実行する本文。`shell`の末尾に`source`を一つの引数として追加して起動する。\nどちらにも`${...}`の値置換は行わない(docs/specs/execution.md#script)。",
            "type": "object",
            "properties": {
                "shell": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "source": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "required": ["shell", "source"]
        },
        "SecretRef": {
            "description": "`$HERDR_PLUGIN_CONFIG_DIR/secrets.yaml`に定義した秘密値の名前だけを持つ。",
            "type": "object",
            "properties": {
                "secret": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "required": ["secret"]
        },
        "StopConfig": {
            "type": "object",
            "properties": {
                "graceSeconds": {
                    "type": ["integer", "null"],
                    "format": "uint64",
                    "default": null,
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "SymlinkPolicy": {
            "type": "string",
            "enum": ["reject"]
        },
        "TabConfig": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                },
                "layout": {
                    "$ref": "#/$defs/LayoutConfig"
                },
                "panes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/PaneConfig"
                    }
                }
            },
            "additionalProperties": false,
            "required": ["id", "label", "layout", "panes"]
        },
        "TaskDef": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "argv": {
                            "description": "`script`と排他で、どちらか一方が必須(意味検証で確認する)。",
                            "type": ["array", "null"],
                            "items": {
                                "type": "string"
                            }
                        },
                        "dependsOn": {
                            "type": "array",
                            "default": [],
                            "items": {
                                "$ref": "#/$defs/DependsOn"
                            }
                        },
                        "env": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/$defs/EnvValue"
                            },
                            "default": {}
                        },
                        "herdrAction": {
                            "description": "他のHerdrプラグインのactionを実行し、その完了を待つ(`argv`・`script`と排他、jobのみ)。",
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/HerdrActionSpec"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "lifecycle": {
                            "$ref": "#/$defs/TaskLifecycle"
                        },
                        "locks": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "onDependencyLost": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/OnDependencyLost"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "default": null
                        },
                        "retry": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/RetryConfig"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "runner": {
                            "$ref": "#/$defs/RunnerKind"
                        },
                        "script": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/ScriptSpec"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "stop": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/StopConfig"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "default": null
                        },
                        "timeoutSeconds": {
                            "type": ["integer", "null"],
                            "format": "uint64",
                            "default": null,
                            "minimum": 0
                        },
                        "type": {
                            "type": "string",
                            "const": "command"
                        },
                        "waitFor": {
                            "description": "`TaskDef`の列挙子間の大きさの差を抑えるため箱に入れる。",
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/WaitFor"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "default": null
                        }
                    },
                    "additionalProperties": false,
                    "required": ["type", "lifecycle", "runner"]
                },
                {
                    "type": "object",
                    "properties": {
                        "agent": {
                            "$ref": "#/$defs/AgentSpec"
                        },
                        "dependsOn": {
                            "type": "array",
                            "default": [],
                            "items": {
                                "$ref": "#/$defs/DependsOn"
                            }
                        },
                        "type": {
                            "type": "string",
                            "const": "agent"
                        }
                    },
                    "additionalProperties": false,
                    "required": ["type", "agent"]
                }
            ]
        },
        "TaskLifecycle": {
            "type": "string",
            "enum": ["job", "service"]
        },
        "WaitFor": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "consecutiveSuccesses": {
                            "type": "integer",
                            "format": "uint32",
                            "minimum": 0
                        },
                        "intervalMilliseconds": {
                            "type": "integer",
                            "format": "uint64",
                            "minimum": 0
                        },
                        "monitor": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/MonitorConfig"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "status": {
                            "type": "integer",
                            "format": "uint16",
                            "maximum": 65535,
                            "minimum": 0
                        },
                        "timeoutSeconds": {
                            "type": "integer",
                            "format": "uint64",
                            "minimum": 0
                        },
                        "type": {
                            "type": "string",
                            "const": "http"
                        },
                        "url": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "url",
                        "status",
                        "timeoutSeconds",
                        "intervalMilliseconds",
                        "consecutiveSuccesses"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "consecutiveSuccesses": {
                            "type": "integer",
                            "format": "uint32",
                            "minimum": 0
                        },
                        "host": {
                            "type": "string",
                            "default": "127.0.0.1"
                        },
                        "intervalMilliseconds": {
                            "type": "integer",
                            "format": "uint64",
                            "minimum": 0
                        },
                        "monitor": {
                            "anyOf": [
                                {
                                    "$ref": "#/$defs/MonitorConfig"
                                },
                                {
                                    "type": "null"
                                }
                            ]
                        },
                        "port": {
                            "$ref": "#/$defs/PortValue"
                        },
                        "timeoutSeconds": {
                            "type": "integer",
                            "format": "uint64",
                            "minimum": 0
                        },
                        "type": {
                            "type": "string",
                            "const": "tcp"
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "type",
                        "port",
                        "timeoutSeconds",
                        "intervalMilliseconds",
                        "consecutiveSuccesses"
                    ]
                },
                {
                    "description": "`monitor`を持たない。指定した場合は未知キーとして拒否する。",
                    "type": "object",
                    "properties": {
                        "pattern": {
                            "type": "string"
                        },
                        "stream": {
                            "$ref": "#/$defs/LogStream",
                            "default": "any"
                        },
                        "timeoutSeconds": {
                            "type": "integer",
                            "format": "uint64",
                            "minimum": 0
                        },
                        "type": {
                            "type": "string",
                            "const": "log"
                        }
                    },
                    "additionalProperties": false,
                    "required": ["type", "pattern", "timeoutSeconds"]
                }
            ]
        },
        "WorkspaceConfig": {
            "type": "object",
            "properties": {
                "initialTab": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/InitialTabPolicy"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "label": {
                    "type": "string"
                },
                "tabs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/TabConfig"
                    }
                }
            },
            "additionalProperties": false,
            "required": ["label", "tabs"]
        },
        "WorktreeConfig": {
            "type": "object",
            "properties": {
                "base": {
                    "type": ["string", "null"],
                    "default": null
                },
                "branch": {
                    "description": "\"${inputs.branch}\" のような値置換は生文字列のまま保持する。置換処理は後続段階。\n`create`では必須、`attach`では省略可能(指定時は対象checkoutのブランチと照合する)。",
                    "type": ["string", "null"]
                },
                "existingBranch": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ExistingBranchPolicy"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "ifAlreadyCheckedOut": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/CheckedOutPolicy"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                },
                "mode": {
                    "$ref": "#/$defs/WorktreeMode"
                }
            },
            "additionalProperties": false,
            "required": ["mode"]
        },
        "WorktreeMode": {
            "oneOf": [
                {
                    "type": "string",
                    "enum": ["create"]
                },
                {
                    "description": "既存checkoutへRunを関連づける。対象パスは設定に書かず実行時に受け取る\n(docs/specs/worktree.md#attach)。",
                    "type": "string",
                    "const": "attach"
                }
            ]
        }
    }
}
